<jasperReport bottomMargin="20" columnWidth="555" language="java" leftMargin="20" name="reports_admin_template_source_sample" pageHeight="842" pageWidth="595" rightMargin="20" topMargin="20">
	<property name="ireport.zoom" value="3.0" />
	<property name="ireport.x" value="0" />
	<property name="ireport.y" value="0" />
	<parameter class="java.lang.String" name="title" />
	<query language="sql"><![CDATA[select * from ListType]]></query>
	<field class="java.lang.String" name="name" />
	<title height="69" splitType="Stretch">
		<element backcolor="#003366" height="69" kind="frame" mode="Opaque" width="555" x="0" y="0" />
		<element forecolor="#FFFFFF" height="18" hTextAlign="Right" key="staticText-7" kind="staticText" width="50" x="360" y="30">
			<text><![CDATA[Time:]]></text>
			<box>
				<topPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<leftPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<rightPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
			</box>
		</element>
		<element forecolor="#FFFFFF" height="18" hTextAlign="Right" key="staticText-6" kind="staticText" width="50" x="360" y="12">
			<text><![CDATA[Date:]]></text>
			<box>
				<topPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<leftPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<bottomPen lineColor="#000000" lineWidth="0.0" />
				<rightPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
			</box>
		</element>
		<element evaluationTime="Report" forecolor="#FFFFFF" height="18" key="textField" kind="textField" pattern="dd/MM/yyyy" width="133" x="422" y="12">
			<expression><![CDATA[new java.util.Date()]]></expression>
			<box>
				<topPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<leftPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<bottomPen lineColor="#000000" lineWidth="0.0" />
				<rightPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
			</box>
		</element>
		<element evaluationTime="Report" forecolor="#FFFFFF" height="18" key="textField" kind="textField" pattern="HH.mm.ss" width="133" x="422" y="30">
			<expression><![CDATA[new java.util.Date()]]></expression>
			<box>
				<topPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<leftPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
				<bottomPen lineColor="#000000" lineWidth="0.0" />
				<rightPen lineColor="#000000" lineStyle="Solid" lineWidth="0.0" />
			</box>
		</element>
		<element fontSize="16.0" forecolor="#FFFFFF" height="29" kind="textField" width="194" x="166" y="28">
			<expression><![CDATA[$P{title}]]></expression>
		</element>
		<element backcolor="#003366" forecolor="#003366" height="58" kind="image" width="414" x="0" y="11">
			<expression><![CDATA["http://www.liferay.com/image/company_logo"]]></expression>
		</element>
	</title>
	<columnHeader height="20">
		<element backcolor="#333333" height="20" kind="frame" mode="Opaque" width="555" x="0" y="0" />
		<element bold="true" forecolor="#FFFFFF" height="20" hTextAlign="Justified" kind="staticText" width="405" x="150" y="0">
			<text><![CDATA[List Type]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<element height="20" kind="textField" width="150" x="0" y="0">
				<expression><![CDATA[$F{name}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="40" splitType="Stretch">
		<element height="20" hTextAlign="Right" kind="textField" width="241" x="212" y="10">
			<expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></expression>
		</element>
		<element evaluationTime="Report" height="20" kind="textField" width="100" x="455" y="10">
			<expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>